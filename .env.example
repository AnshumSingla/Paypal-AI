# Copy to .env.local and fill in. Never commit .env.local.
# Everything is optional: with no keys the app runs on a PayPal stand-in and rule-based AI.

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app (enable Payouts)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# A sandbox PERSONAL account email (Testing Tools > Sandbox Accounts); receives supplier payouts.
PAYPAL_SANDBOX_PERSONAL_EMAIL=
# Webhook pointing at https://<your-host>/api/webhooks/paypal (after you deploy).
PAYPAL_WEBHOOK_ID=
# Optional: existing billing plan ids; otherwise plans are created on first use.
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_PARTNER=

# --- AI (free keys; Gemini is tried first, Groq if Gemini fails) ---
# Gemini: aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Channel3 (promo code PAYPAL-HACKATHON-2026 for 20k credits) ---
CHANNEL3_API_KEY=

# --- AG Grid / AG Studio (45-day trial key) ---
AG_STUDIO_LICENSE=

# --- Offline switches (optional) ---
# Force the built-in PayPal stand-in and/or rule-based AI even when keys are set.
# PAYPAL_MODE=mock
# AI_MODE=rules
# Cap on AI calls per hour for a public demo (default 300).
# AI_CALLS_PER_HOUR=300

# --- App ---
# Leave DATABASE_URL unset locally to use the embedded database in ./.data; Render sets it.
# DATABASE_URL=postgres://user:password@localhost:5432/collective
DEMO_MODE=true
