# Copy to .env.local and fill in. Never commit .env.local.

# --- PayPal (sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your REST app
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox PERSONAL account email (Testing Tools > Sandbox Accounts). Used as the payout receiver in spikes.
PAYPAL_SANDBOX_PERSONAL_EMAIL=
# Filled in later (Day 4/5)
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_ID_PRO=
PAYPAL_PLAN_ID_PARTNER=

# --- Claude ---
ANTHROPIC_API_KEY=
# Default model for agents; override if you prefer another Claude model
CLAUDE_MODEL=claude-opus-5-5

# --- Channel3 (promo code PAYPAL-HACKATHON-2026 for 20k credits) ---
CHANNEL3_API_KEY=

# --- AG Grid / AG Studio (45-day trial key) ---
AG_STUDIO_LICENSE=

# --- Offline switches (optional) ---
# Force the built-in PayPal stand-in and/or rule-based AI even when keys are set.
# PAYPAL_MODE=mock
# AI_MODE=rules
# Cap on Claude calls per hour for a public demo (default 300).
# AI_CALLS_PER_HOUR=300

# --- App ---
DATABASE_URL=postgres://poolcart:poolcart@localhost:5432/poolcart
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
DEMO_MODE=true
